@charset "utf-8";

body { font-family: Alexandria, sans-serif; background-color: rgb(15, 23, 42); color: rgb(248, 250, 252); }

.luxury-font { font-family: "Playfair Display", serif; }

.gold-gradient { background: linear-gradient(135deg, rgb(251, 191, 36) 0%, rgb(217, 119, 6) 100%); }

.glass-panel { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }

@keyframes border-glow { 
  0% { border-color: rgba(251, 191, 36, 0.3); box-shadow: rgba(251, 191, 36, 0) 0px 0px 0px; }
  50% { border-color: rgb(251, 191, 36); box-shadow: rgba(251, 191, 36, 0.4) 0px 0px 15px; }
  100% { border-color: rgba(251, 191, 36, 0.3); box-shadow: rgba(251, 191, 36, 0) 0px 0px 0px; }
}

#uploadForm input[type="text"] { transition: 0.3s; }

#uploadForm input[type="text"]:focus { animation: 1.5s ease-in-out 0s infinite normal none running border-glow; outline: none; border-color: rgb(251, 191, 36); }

.image-preview-container { transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1); transform: scale(0.98); }

.image-preview-container:hover { transform: scale(1); border-color: rgba(251, 191, 36, 0.5); }
